{
  "name": "ensure-source-branch-contains-destination-branch",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "ncc build index.js --license licenses.txt -o dist",
    "build:verify": "npm run build && git diff --exit-code dist/",
    "format": "prettier --write .",
    "format:verify": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "[ \"$CI\" = \"true\" ] || npx simple-git-hooks"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "@vitest/eslint-plugin": "^1.6.16",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "vitest": "^4.1.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npm ci && npm run format && npm run lint && npm run test && npm run build && git add -u"
  }
}
