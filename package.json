{
  "name": "ensure-source-branch-contains-destination-branch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "ncc build index.js --license licenses.txt -o dist",
    "lint": "npm run lint:prettier && npm run lint:eslint",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "postinstall": "[ \"$CI\" = \"true\" ] || npx simple-git-hooks"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.4",
    "eslint": "^10.2.0",
    "eslint-plugin-vitest": "^0.5.4",
    "prettier": "^3.8.2",
    "simple-git-hooks": "^2.13.1",
    "vitest": "^4.1.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run format && npm run lint && npm test && npm run build && git add -u"
  }
}
